# Copy to .env for local runs (".env" is git-ignored). In GitHub use repository secrets instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_PRICE_EUR=999.99
# Optional:
# MIN_PRICE_DROP_EUR=10.00        # re-alert for an already alerted offer only if it got this much cheaper
# RETAILERS_CONFIG=config/retailers.yml
# DB_PATH=state/ps5_monitor.db
# HEALTH_SUMMARY=false            # daily health message via Telegram
# HEALTH_SUMMARY_HOUR=8           # Europe/Berlin hour after which it is sent
# HTTP_TIMEOUT=15
# HTTP_MAX_RETRIES=3
# RESPECT_ROBOTS=true
# LOG_LEVEL=INFO
# LOG_FORMAT=json                 # or text
